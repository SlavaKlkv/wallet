# Django
SECRET_KEY=change-me
DEBUG=False
CSRF_TRUSTED_ORIGINS=https://site-domen.com

# 1 — поднять проект на SQLite вместо PostgreSQL (удобно для тестов)
USE_SQLITE=0

# PostgreSQL
POSTGRES_USER=django_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=django
DB_HOST=db
DB_PORT=5432

# Медиафайлы вне локального окружения
MEDIA_ROOT=/media

# Ускоряет сборку Docker Compose, если поддерживается bake
COMPOSE_BAKE=true
